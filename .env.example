# Copy this to Replit's "Secrets" panel (padlock icon) — never commit real
# values to a .env file in source control.

# Set automatically when you enable Replit's built-in PostgreSQL database
# (Tools -> Database -> PostgreSQL). Copy the connection string it gives you.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

PORT=3000
